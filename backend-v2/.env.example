###############################################################################
# Mobius Smart Recycling Bin - backend-v2 environment template
#
# Copy this file to `.env` and fill in the values for your machine. The `.env`
# file is excluded from source control. Every key listed below is read by some
# part of the Laravel application; missing keys will cause the matching feature
# to fail at run time.
###############################################################################

# --- Application -------------------------------------------------------------
APP_NAME=mobius-v2
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL via Homebrew on the developer machine) ------------------
# Install:    brew install mysql && brew services start mysql
# Create db:  mysql -u root -e "CREATE DATABASE mobius_v3;"
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mobius_v3
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions, broadcasting, queue, cache, filesystem ------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (Mailtrap sandbox SMTP for development) ----------------------------
# Sign up at https://mailtrap.io and copy the inbox SMTP credentials here.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@mobius.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS (only needed if SES mail driver or S3 filesystem are used) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Vite (frontend build) ---------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"

# --- Google Maps and Directions APIs ----------------------------------------
# Used by the AI dynamic route optimisation module.
# https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_MAPS_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=

# --- OpenAI (cup brand classification) ---------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Roboflow (custom-trained RF-DETR detector for the waste type stage) -----
# The trained checkpoint (weights.pt) is hosted by Roboflow and inferenced via
# the serverless endpoint below. See the project supervisor for access to the
# specific workspace and model version.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=mobius-v2/1
ROBOFLOW_API_URL=https://serverless.roboflow.com

# --- Route Optimisation (legacy local solver, replaced by Google APIs) -------
# These keys are retained for reference only. The current implementation uses
# the Google Maps and Directions API keys above; the local VROOM container is
# no longer required.
VROOM_URL=http://localhost:3000
ROUTE_PROXIMITY_THRESHOLD_METERS=200

# --- Stripe (subscription billing for store and brand owners) ----------------
# Use the test keys from https://dashboard.stripe.com/test/apikeys until going
# live. Laravel Cashier reads STRIPE_KEY and STRIPE_SECRET; the webhook secret
# is needed only when wiring the Stripe webhook receiver.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Twilio Verify (one-time password for public user account creation) ------
# https://www.twilio.com/console -> Verify -> Services
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_VERIFY_SID=
