# Mobius bin-client environment template.
# Copy to `.env` and fill in the value for your network.
#
# VITE_API_URL points at the Laravel server's API root. When the Laravel server
# is started with `php artisan serve --host 0.0.0.0 --port 8000`, set this to
# the host machine's local network IP, for example:
#
#   VITE_API_URL=http://192.168.1.50:8000/api/v1
#
# All devices on the same Wi-Fi network can then reach the API.
VITE_API_URL=http://127.0.0.1:8000/api/v1
